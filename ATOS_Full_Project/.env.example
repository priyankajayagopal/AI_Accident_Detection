# Copy to .env (never commit real keys). Everything works with the defaults and NO keys.
DATABASE_URL=sqlite:///storage/atos.db
# DATABASE_URL=postgresql+psycopg2://atos:atos@localhost:5432/atos
ATOS_LLM_BACKEND=rule          # rule | anthropic | gemini  (explanations / report summary only)
ATOS_VLM_BACKEND=mock          # mock | anthropic | gemini  (second-stage verification)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ATOS_DETECTOR=auto             # auto | yolo | color | motion
